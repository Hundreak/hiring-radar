# Hiring Radar / AI-assisted job matching platform
# Copy this file to .env for local development. Never commit .env.

# Runtime
HIRING_RADAR_ENV=development
HIRING_RADAR_API_HOST=127.0.0.1
HIRING_RADAR_API_PORT=8000
HIRING_RADAR_API_RELOAD=1
HIRING_RADAR_APP_BASE_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

# Storage
HIRING_RADAR_DB_PATH=data/hiring_radar.db
HIRING_RADAR_SETTINGS_PATH=config/settings.example.yml
HIRING_RADAR_ENV_PATH=.env
HIRING_RADAR_UPLOAD_DIR=data/uploads
HIRING_RADAR_EMPLOYER_OUTREACH_STORE_PATH=data/employer_outreach.json

# Admin auth
HIRING_RADAR_ADMIN_EMAIL=admin@example.com
HIRING_RADAR_ADMIN_PASSWORD=change-me-locally
HIRING_RADAR_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
HIRING_RADAR_ADMIN_SESSION_TTL_SECONDS=43200
# In production, cookie secure defaults to true; set explicitly only if needed.
HIRING_RADAR_ADMIN_SESSION_COOKIE_SECURE=0
HIRING_RADAR_ADMIN_SESSION_COOKIE_SAMESITE=lax

# User auth / sessions
HIRING_RADAR_AUTH_SECRET=replace-with-a-long-random-secret
HIRING_RADAR_SECRET_KEY=
HIRING_RADAR_USER_SESSION_SECRET=
HIRING_RADAR_SESSION_COOKIE_NAME=hiring_radar_session
HIRING_RADAR_SESSION_TTL_SECONDS=1209600
HIRING_RADAR_SESSION_SIGNING_SALT=hiring-radar-user-session-v1
HIRING_RADAR_SESSION_COOKIE_SECURE=0
HIRING_RADAR_SESSION_COOKIE_SAMESITE=lax
HIRING_RADAR_MAGIC_LINK_TTL_SECONDS=1800
HIRING_RADAR_PASSWORD_RESET_TTL_SECONDS=1800
HIRING_RADAR_SIGNUP_VERIFICATION_TTL_SECONDS=600
HIRING_RADAR_PASSWORD_MIN_LENGTH=10
HIRING_RADAR_PASSWORD_PBKDF2_ITERATIONS=600000
HIRING_RADAR_FRONTEND_LOGIN_PATH=/tr/login
HIRING_RADAR_FRONTEND_RESET_PASSWORD_PATH=/tr/reset-password

# Employer auth
HIRING_RADAR_EMPLOYER_SESSION_SECRET=replace-with-a-long-random-secret
# In production, cookie secure defaults to true.
HIRING_RADAR_EMPLOYER_SESSION_COOKIE_SECURE=0
HIRING_RADAR_EMPLOYER_SESSION_COOKIE_SAMESITE=lax
# Employer demo/mock surfaces. Production hard-locks both to false even if misconfigured.
HIRING_RADAR_EMPLOYER_DEMO_MODE=1
HIRING_RADAR_EMPLOYER_ALLOW_MOCK_AUTH=1

# SMTP / email delivery
HIRING_RADAR_SMTP_HOST=smtp.example.com
HIRING_RADAR_SMTP_PORT=587
HIRING_RADAR_SMTP_USERNAME=user@example.com
HIRING_RADAR_SMTP_PASSWORD=replace-me
HIRING_RADAR_SMTP_USE_TLS=true
HIRING_RADAR_EMAIL_FROM=Hiring Radar <noreply@example.com>
HIRING_RADAR_EMAIL_TO_DEFAULT=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Local AI runtime
AI_ENABLED=false
AI_RUNTIME=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_DEFAULT_MODEL=
AI_HEALTH_TIMEOUT_SECONDS=3
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1
AI_STRICT_LOCAL_ONLY=true
AI_AUDIT_ENABLED=true
AI_AUDIT_LOG_DIR=data/ai_audit
AI_AUDIT_PREVIEW_CHARS=240

# CV parsing / OCR
HIRING_RADAR_CV_OCR_LANG=tur+eng
HIRING_RADAR_CV_AI_STRUCTURING=auto


# CSRF protection for cookie-authenticated browser mutations
# Keep enabled in production. The frontend automatically mirrors this cookie into X-CSRF-Token.
HIRING_RADAR_CSRF_ENABLED=true
HIRING_RADAR_CSRF_COOKIE_NAME=hiring_radar_csrf
HIRING_RADAR_CSRF_HEADER_NAME=X-CSRF-Token
HIRING_RADAR_CSRF_COOKIE_MAX_AGE_SECONDS=1209600
HIRING_RADAR_CSRF_COOKIE_SECURE=0
HIRING_RADAR_CSRF_COOKIE_SAMESITE=lax
NEXT_PUBLIC_CSRF_COOKIE_NAME=hiring_radar_csrf
NEXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token

# Abuse protection / rate limiting
# Keep enabled in production. Disable only for controlled local diagnostics.
HIRING_RADAR_RATE_LIMIT_ENABLED=true
# Trust X-Forwarded-For / X-Real-IP only when the API is behind a trusted reverse proxy.
HIRING_RADAR_RATE_LIMIT_TRUST_PROXY_HEADERS=false
# Optional per-action overrides use this shape:
# HIRING_RADAR_RATE_LIMIT_<ACTION>_IP_LIMIT=40
# HIRING_RADAR_RATE_LIMIT_<ACTION>_IP_WINDOW_SECONDS=900
# HIRING_RADAR_RATE_LIMIT_<ACTION>_IDENTITY_LIMIT=6
# HIRING_RADAR_RATE_LIMIT_<ACTION>_IDENTITY_WINDOW_SECONDS=1800
# Common actions:
# USER_PASSWORD_LOGIN, USER_MAGIC_LINK_REQUEST, USER_PASSWORD_RESET_REQUEST,
# PUBLIC_SIGNUP_REQUEST, PUBLIC_SIGNUP_CONFIRM, USER_TOTP_VERIFY,
# USER_UPLOAD_CV, EMPLOYER_LOGIN, ADMIN_LOGIN

# API observability / diagnostics
HIRING_RADAR_OBSERVABILITY_ENABLED=true
HIRING_RADAR_REQUEST_ID_HEADER=X-Request-ID
HIRING_RADAR_RESPONSE_TIME_HEADER=X-Response-Time-Ms
HIRING_RADAR_TRUST_INCOMING_REQUEST_ID=true
HIRING_RADAR_LOG_REQUESTS=true
HIRING_RADAR_LOG_SLOW_REQUESTS=true
HIRING_RADAR_SLOW_REQUEST_THRESHOLD_MS=750
HIRING_RADAR_EXPOSE_RESPONSE_TIME_HEADER=true
HIRING_RADAR_JSON_LOGS=true
