HIRING_RADAR_ENV=development
HIRING_RADAR_LOG_LEVEL=INFO
HIRING_RADAR_DB_PATH=data/hiring_radar.db
HIRING_RADAR_EXPORT_DIR=data/exports
HIRING_RADAR_LOG_FILE=logs/hiring_radar.log
HIRING_RADAR_COMPANIES_CONFIG=config/companies.example.yml
HIRING_RADAR_SETTINGS_PATH=config/settings.local.yml
HIRING_RADAR_ENV_PATH=.env

HIRING_RADAR_API_HOST=127.0.0.1
HIRING_RADAR_API_PORT=8000
HIRING_RADAR_API_RELOAD=true

# Admin panel / API auth
HIRING_RADAR_ADMIN_EMAIL=admin@example.com
HIRING_RADAR_ADMIN_PASSWORD=change-me
HIRING_RADAR_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
HIRING_RADAR_ADMIN_SESSION_TTL_SECONDS=43200

# Email / SMTP settings
HIRING_RADAR_SMTP_HOST=smtp.example.com
HIRING_RADAR_SMTP_PORT=587
HIRING_RADAR_SMTP_USERNAME=your-smtp-username
HIRING_RADAR_SMTP_PASSWORD=your-smtp-password
HIRING_RADAR_SMTP_USE_TLS=true
HIRING_RADAR_EMAIL_FROM=alerts@example.com
HIRING_RADAR_EMAIL_TO_DEFAULT=you@example.com


# Public app base URL used in user magic-link emails
HIRING_RADAR_APP_BASE_URL=http://127.0.0.1:8000

# User auth / magic-link
HIRING_RADAR_USER_SESSION_SECRET=replace-with-a-different-long-random-secret
HIRING_RADAR_USER_SESSION_TTL_SECONDS=259200
HIRING_RADAR_MAGIC_LINK_TTL_SECONDS=900

# Google OAuth (obtain from https://console.cloud.google.com/ → APIs & Services → Credentials)
# Authorized redirect URI must be: {HIRING_RADAR_APP_BASE_URL}/api/user/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/user/auth/google/callback