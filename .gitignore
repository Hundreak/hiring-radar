# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Python environments / packaging
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Local environment files
.env
.env.*
!.env.example

# Local tooling / editor state
.DS_Store
.vscode/
.idea/
.claude/

# Logs and runtime outputs
logs/
*.log

# Application runtime data
# Keep the folder skeleton in Git, but never commit local databases, uploads,
# OCR/CV diagnostics, AI audit logs, generated exports, or repair backups.
data/*
!data/.gitkeep
!data/exports/
data/exports/*
!data/exports/.gitkeep

*.db
*.sqlite
*.sqlite3
*.db.bak*
*.sqlite.bak*
*.sqlite3.bak*
*.csv

# Local config overrides
config/*.local.yml

# Frontend dependencies / build caches
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/tsconfig.tsbuildinfo

# Generated archives / handoff packages
*.zip
*.tar
*.tar.gz
*.tar.xz

# Temporary backup snapshots
.backup_*/
*_backup/
*.bak

# Patch/çalışma notları — yerel geçmiş kaydıdır, ürün kaynağı değil
PATCH_*_NOTES.md
PATCH_*_SUMMARY.md
PATCH_*_DELETE_FILES.txt
_PATCH_*
_DELETE_FILES.txt
